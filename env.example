# Copy to .env.local only for local testing. Never commit the real values.
GEMINI_API_KEY=replace_with_google_ai_studio_key
VIDYA_OWNER_TOKEN=replace_with_at_least_32_random_characters
VIDYA_OWNER_USER_ID=replace_with_supabase_auth_user_uuid
VIDYA_CRON_SECRET=replace_with_a_different_32_character_secret
VIDYA_ALLOWED_ORIGINS=https://YOUR_GITHUB_NAME.github.io,http://localhost:4173

# Safe, affordable routing: routine work uses Lite; research, briefs and vision use Flash.
VIDYA_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
VIDYA_GEMINI_REASONING_MODEL=gemini-3.7-flash
VIDYA_FAST_INPUT_USD_PER_MILLION=0.30
VIDYA_FAST_OUTPUT_USD_PER_MILLION=2.50
VIDYA_REASONING_INPUT_USD_PER_MILLION=0.75
VIDYA_REASONING_OUTPUT_USD_PER_MILLION=3.75
VIDYA_GROUNDING_USD_PER_REQUEST=0
VIDYA_REQUESTS_PER_HOUR=60

# Recommended for new Supabase projects. This must be a server-side sb_secret key.
VIDYA_SUPABASE_SECRET_KEY=replace_with_sb_secret_key
# Only needed when upgrading the browser app to Supabase Auth/JWT.
VIDYA_SUPABASE_PUBLISHABLE_KEY=replace_with_sb_publishable_key
